+// vakt: an embedding program may register the metallib bytes before the
+// first Metal use so the final binary needs no external mlx.metallib.
+const void* vakt_embedded_metallib_ = nullptr;
+size_t vakt_embedded_metallib_size_ = 0;
+
+std::pair<MTL::Library*, NS::Error*> load_embedded_library(
+    MTL::Device* device) {
+  if (vakt_embedded_metallib_ == nullptr || vakt_embedded_metallib_size_ == 0) {
+    return {nullptr, nullptr};
+  }
+  // dispatch_data_create with the default destructor copies the bytes.
+  auto data = dispatch_data_create(
+      vakt_embedded_metallib_,
+      vakt_embedded_metallib_size_,
+      nullptr,
+      DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  NS::Error* error = nullptr;
+  auto lib = device->newLibrary(data, &error);
+  dispatch_release(data);
+  return {lib, error};
+}
